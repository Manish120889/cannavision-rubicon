// CannaVision AI Master PostgreSQL Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  status     String     @default("ACTIVE")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  facilities Facility[]
  users      User[]
}

model Facility {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  name       String      // e.g., "Pacifica Facility (Delta, BC)"
  address    String?
  timezone   String      @default("America/Vancouver")
  status     String      @default("ACTIVE")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  rooms      Room[]
  devices    Device[]
  alerts     Alert[]
  auditLogs  AuditLog[]
}

model Room {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  name        String    // e.g., "Flower Room #4"
  roomType    String    @default("FLOWER")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  zones       Zone[]
  alerts      Alert[]
}

model Zone {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  name        String    // e.g., "Row 4 / Unit 12"
  benchCode   String
  status      String    @default("ACTIVE")
  plants      Plant[]
}

model Plant {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  roomId      String
  zoneId      String
  zone        Zone      @relation(fields: [zoneId], references: [id])
  cultivar    String    // e.g., "BC Organic Lime Mi'kjane"
  growthStage String    // e.g., "LATE_FLOWER"
  externalRef String?   // METRC Tag ID
  createdAt   DateTime  @default(now())
}

model Device {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  deviceName  String
  platform    String    // "ANDROID" | "IOS" | "DESKTOP_ELECTRON"
  mdmId       String?
  trustStatus String    @default("TRUSTED")
  createdAt   DateTime  @default(now())
}

model User {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  email       String    @unique
  fullName    String
  role        String    @default("CULTIVATOR")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  decisions   ReviewDecision[]
}

model ScanSession {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  roomId      String
  zoneId      String
  deviceId    String
  operatorId  String
  status      String    @default("COMPLETED")
  startedAt   DateTime  @default(now())
  syncedAt    DateTime?
  images      ScanImage[]
}

model ScanImage {
  id             String    @id @default(uuid())
  scanSessionId  String
  scanSession    ScanSession @relation(fields: [scanSessionId], references: [id])
  objectUri      String
  sha256Hash     String
  width          Int
  height         Int
  metadataJson   String
  createdAt      DateTime  @default(now())
  inferenceRuns  AIInferenceRun[]
}

model AIInferenceRun {
  id             String    @id @default(uuid())
  scanImageId    String
  scanImage      ScanImage @relation(fields: [scanImageId], references: [id])
  modelVersion   String    @default("v2.4.1-yolov8")
  location       String    @default("FACILITY_EDGE")
  completedAt    DateTime  @default(now())
  detections     Detection[]
}

model Detection {
  id              String    @id @default(uuid())
  inferenceRunId  String
  inferenceRun    AIInferenceRun @relation(fields: [inferenceRunId], references: [id])
  classLabel      String    // "POWDERY_MILDEW" | "SPIDER_MITE" | "HEALTHY"
  confidence      Float
  bboxJson        String
  severity        String    @default("HIGH_RISK")
}

model Alert {
  id              String    @id @default(uuid())
  tenantId        String
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id])
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id])
  riskType        String    // "SPIDER_MITE_PREDICTION" | "PM_HUMIDITY_SPIKE"
  severity        String    @default("WARNING")
  status          String    @default("OPEN")
  createdAt       DateTime  @default(now())
  reviewDecisions ReviewDecision[]
}

model ReviewDecision {
  id              String    @id @default(uuid())
  alertId         String
  alert           Alert     @relation(fields: [alertId], references: [id])
  reviewerId      String
  reviewer        User      @relation(fields: [reviewerId], references: [id])
  decision        String    // "CONFIRMED" | "CORRECTED" | "ESCALATED"
  correctedLabel  String?
  notes           String?
  reviewedAt      DateTime  @default(now())
}

model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  actorId     String
  action      String    // "SCAN_CAPTURED" | "ALERT_REVIEWED" | "MODEL_DEPLOYED"
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime  @default(now())
}
